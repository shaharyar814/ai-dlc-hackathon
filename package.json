{
  "name": "fulfillment-watch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "scan:secrets": "gitleaks dir . --config .gitleaks.toml --no-banner --redact --verbose && gitleaks git . --config .gitleaks.toml --no-banner --redact --verbose",
    "scan:sast": "semgrep scan --metrics=off --disable-version-check --error --quiet --config p/typescript --config p/react --config p/security-audit src index.html vite.config.ts",
    "check": "npm run lint && npm run scan:secrets && npm run scan:sast",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "4.10.3",
    "globals": "^17.13.0",
    "jsdom": "31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
